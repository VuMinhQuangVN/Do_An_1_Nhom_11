@model DiemRenLuyen.Models.SinhVienModels.GiangVien

<body>
    <div class="wrapper">
        <header>
            <div class="header-content">
                <h2>Hệ thống chấm điểm rèn luyện</h2>
                <div class="user-info">
                    <span>@Model.TenGV</span>
                    <a asp-controller="TaiKhoans" asp-action="Index">Đăng xuất</a>
                </div>
            </div>
        </header>

        <div class="main-content">
            <nav>
                <a asp-controller="GiangViens" asp-action="Index">Trang chủ</a>
                <a asp-controller="GiangViens" asp-action="DanhSachPhieu">Duyệt phiếu</a>
                <a asp-controller="GiangViens" asp-action="DaDuyet">Phiếu đã duyệt</a>
            </nav>

            <main class="main1">
                <h2>👨‍🏫 Chào mừng giảng viên đến với Hệ thống chấm điểm rèn luyện</h2>

                <div class="teacher-info-box">
                    <h4>📝 Thông tin giảng viên</h4>
                    <ul class="info-list">
                        <li><strong>Họ tên:</strong> @Model.TenGV</li>
                        <li><strong>Mã GV:</strong> @Model.MaGV</li>
                        <li><strong>Email:</strong> @Model.Email</li>
                        <li><strong>Điện thoại:</strong> @Model.DienThoai</li>
                        <li><strong>Khoa:</strong> @Model.MaKhoa</li>
                    </ul>
                </div>

                <hr />

                <div class="guide-box">
                    <h4>📘 Hướng dẫn nhanh</h4>
                    <ul>
                        <li>📋 Vào mục <strong>"Duyệt phiếu"</strong> để xem danh sách sinh viên nộp phiếu tự chấm</li>
                        <li>🔍 Kiểm tra, sửa điểm và duyệt từng phiếu</li>
                        <li>📑 Xem lại các phiếu đã duyệt trong mục <strong>"Phiếu đã duyệt"</strong></li>
                    </ul>
                </div>

                <a href="/GiangViens/DanhSachPhieu" class="btn-start">🚀 Bắt đầu duyệt phiếu</a>
            </main>
        </div>

        <footer>
            © 2025 – Hệ thống chấm điểm rèn luyện
        </footer>
    </div>
</body>
