@{
}
@{
    ViewData["Title"] = "Không trong thời gian đánh giá";
}


<body>
    <div class="wrapper">
        <header>
            <div class="header-content">
                <h2>Hệ thống chấm điểm rèn luyện</h2>
                <div class="user-info">
                    <span>@Model.HoTen</span>
                    <a asp-controller="TaiKhoans" asp-action="Index">Đăng xuất</a>
                </div>
            </div>
        </header>

        <div class="main-content">
            <nav>
                <a asp-controller="SinhViens" asp-action="Index">Trang chủ</a>
                <a asp-controller="SinhViens" asp-action="TuChamDiem">Tự chấm điểm</a>
                <a asp-controller="SinhViens" asp-action="KetQua">Kết quả</a>
            </nav>

            <main class="main1">
                <div class="container mt-5">
                    <div class="alert alert-warning text-center" role="alert">
                        <h4 class="alert-heading">Thông báo!</h4>
                        <p>@ViewBag.ThongBao</p>
                        <hr />
                        <a class="btn btn-primary mt-2" href="@Url.Action("Index", "Home")">Quay lại trang chủ</a>
                    </div>
                </div>
            </main>
        </div>

        <footer>
            © 2025 – Hệ thống chấm điểm rèn luyện
        </footer>
    </div>
</body>